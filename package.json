{
  "name": "crewrota",
  "version": "1.0.3",
  "description": "Run Claude Code as any of your crew members: one login each, shared history, quota at a glance.",
  "keywords": [
    "claude",
    "claude-code",
    "cli",
    "accounts",
    "crew",
    "anthropic",
    "multi-account",
    "quota",
    "usage-limits",
    "rate-limits"
  ],
  "homepage": "https://crewrota.pasindug.com",
  "bugs": {
    "url": "https://github.com/pasindu-premachandra/crewrota/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/pasindu-premachandra/crewrota.git"
  },
  "license": "MIT",
  "author": "Pasindu Premachandra",
  "type": "module",
  "engines": {
    "node": ">=22.19"
  },
  "bin": {
    "crewrota": "dist/cli.js",
    "crw": "dist/cli.js",
    "crew": "dist/cli.js"
  },
  "files": [
    "dist",
    "!dist/test",
    "templates",
    "widget",
    "NOTICE"
  ],
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test \"dist/test/*.test.js\"",
    "check:private": "node scripts/check-private.mjs",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@clack/core": "1.5.1",
    "@clack/prompts": "^1.8.1",
    "quota-axi": "0.1.68"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  }
}
